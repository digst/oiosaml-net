{
  "AppSettings": {
    "oiosamlProfile": "oiosaml3"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DK.Gov.Oio.Saml.Audit": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-dd'T'HH':'mm':'ss.fff'Z'"
      }
    }
  },
  "AllowedHosts": "*",
  "oiosaml": {
    "serviceProvider": {
      "server": "https://localhost:20002",
      "loginRedirectUrl": "/home/secure",
      "logoutRedirectUrl": "/home",
      "certificate": {
        "filePath": "certificates/serviceprovider.p12"
      }
    },
    "identityProvider": {
      "entityId": "https://saml.test-devtest4-nemlog-in.dk"
    },
    "session": {
      "idleTimeout": "00:30:00",
      "maximumLength": "08:00:00"
    },
    "allowedClockSkew": "00:03:00",
    "levelOfAssurance": {
      "minimumLoa": "Low"
    },
    "login": {
      "allowParametersFromRequest": true
    },
    "appSwitchReturnUrls": [
      {
        "platform": "Android",
        "value": "Some android app link"
      },
      {
        "platform": "iOS",
        "value": "Some ios app link"
      }
    ]
  }
}
