@model HandleErrorInfo
@{
    ViewBag.Title = "Error";
}

<h1 class="text-danger">Error.</h1>
<h2 class="text-danger">An error occurred while processing your request.</h2>

<p>
    Set <code>customErrors mode="Off"</code> in Web.config, or browse from the server itself, to see the exception.
    <strong>Don't do this for deployed applications</strong>: it can show sensitive information from exceptions to end users.
</p>
