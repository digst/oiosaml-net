<Project>
    <!-- One version per package for every project; a csproj references a package without a Version. -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!-- Core library -->
    <ItemGroup>
        <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
        <PackageVersion Include="FluentValidation" Version="11.12.0" />
        <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
        <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageVersion Include="System.Collections.Immutable" Version="10.0.14" />
        <PackageVersion Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
        <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    </ItemGroup>

    <!-- Host integrations and samples -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.14" />
        <PackageVersion Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="4.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.3" />
        <PackageVersion Include="Microsoft.Owin.Security.Cookies" Version="4.2.3" />
    </ItemGroup>

    <!-- Tests -->
    <ItemGroup>
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageVersion Include="Moq" Version="4.21.0" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>
</Project>
